{
  "name": "dsh-session-ops",
  "version": "1.1.0",
  "private": true,
  "description": "给 DSH 侧栏会话行菜单补上「打开工作区位置」「移动到工作区」与「删除会话（进回收站、可撤销）」三项操作的本地插件（宿主半边 + 浏览器半边）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "workspace",
    "open",
    "reveal",
    "explorer",
    "move",
    "delete",
    "trash"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
